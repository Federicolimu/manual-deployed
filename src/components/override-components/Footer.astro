---
import config from "@/config/config.json";
import { Icon } from "@astrojs/starlight/components";
import { markdownify } from "@/lib/utils/textConverter";
import { getTranslations } from "@/lib/utils/languagePerser";

const locale = Astro.currentLocale;

const menu = await getTranslations(locale || "en");

const footer = menu.footer;
const currentLocal = Astro.currentLocale || "en";
const social = { main: [] };
---

<footer>
  <div class="container">
    <div class="top-footer">


      {
        config?.params?.footer_contact?.enable && (
          <div class="footer-contact">
            <h4>Contáctanos</h4>

            <ul class="social-icons">
              {social.main.map((item, index) => (
                <>
                  <li>
                    <a href={item.href} aria-label={item.label}>
                      <Icon
                        name={item?.icon as any}
                        color="var(--sl-color-white)"
                        size="20px"
                      />
                    </a>
                  </li>
                  {index < social.main.length - 1 && (
                    <li class="separator">•</li>
                  )}
                </>
              ))}
            </ul>
          </div>
        )
      }
    </div>
    <div class="bottom-footer">
      <p set:html={markdownify(config?.params?.copyright)} />
      <a href={currentLocal + "/privacy-policy"}
        >{Astro.locals.t("footer.privacy", "Privacy Policy")}</a
      >
    </div>
  </div>
</footer>

<style>
  @layer starlight.core {
    .top-footer {
      border-bottom: 1px solid var(--sl-color-gray-6);
      padding: 60px 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 2rem;
    }
    .top-footer h4 {
      font-size: 1.5rem !important;
      margin-bottom: 1rem;
    }

    .social-icons {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
      padding: 0;
      list-style: none;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
    }
    .social-icons .separator {
      color: var(--sl-color-white);
      font-size: 1.5rem;
      line-height: 1;
      margin: 0 0.2rem;
    }
    .social-icons li a {
      background: color-mix(in srgb, var(--sl-color-gray-4) 20%, transparent);
      width: 45px;
      height: 45px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.6s ease;
    }
    .social-icons li a:hover {
      background: var(--color-primary-gradient);
      color: white !important;
    }

    .bottom-footer {
      padding: 32px 0;
      border-top: 1px solid var(--sl-color-hairline);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .bottom-footer a {
      color: var(--sl-color-text);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .bottom-footer a:hover {
      color: var(--color-primary);
    }
  }
</style>
